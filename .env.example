# ─────────────────────────────────────────────────────────────
# FUNDING CARRY FARMER — Environment Configuration
# Copy to .env and fill in your values before running locally.
# On Railway: set these as environment variables in the dashboard.
# ─────────────────────────────────────────────────────────────

# ── Telegram ──────────────────────────────────────────────────
# Get bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Your personal Telegram chat ID (send /start to @userinfobot to find it)
# Only this chat ID can issue commands — all others are silently ignored
TELEGRAM_CHAT_ID=

# ── Bybit API ─────────────────────────────────────────────────
# Required only when PAPER_MODE=false
# Create at: https://www.bybit.com/app/user/api-management
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Set to true to use Bybit testnet (https://testnet.bybit.com)
BYBIT_TESTNET=false

# ── Database (optional) ───────────────────────────────────────
# Bot runs fully without a database — trades are logged to stdout only.
# PostgreSQL connection string. On Railway: add a Postgres plugin and copy its DATABASE_URL.
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=

# ── Mode ─────────────────────────────────────────────────────
# PAPER_MODE=true  → simulate fills, no real orders placed
# PAPER_MODE=false → live trading on Bybit (requires API keys)
PAPER_MODE=true

# ── Capital & Position Sizing ─────────────────────────────────
# Simulated account size (used for ROI% calculation in paper mode)
PAPER_CAPITAL=1000

# Fixed notional per trade in USD
POSITION_SIZE_USD=500

# Maximum leverage allowed on exchange margin
MAX_LEVERAGE=10

# ── Strategy Parameters ───────────────────────────────────────
# Minimum absolute funding rate to qualify (0.02 = 2.0%)
FUNDING_THRESHOLD=0.02

# Confirm the carry edge at T-CONFIRM_GATE_SEC
CONFIRM_GATE_SEC=30

# Enter the funding receiver leg at T-ENTRY_WINDOW_SEC
ENTRY_WINDOW_SEC=20

# Wait this long after funding settlement before assuming the credit is applied
FUNDING_SETTLE_GRACE_SEC=10

# Exit this many seconds after funding settlement
HARD_EXIT_SEC=15

# Paper mode slippage simulation (0.0003 = 0.03%)
SLIPPAGE_PCT=0.0003

# Minimum expected net edge after entry/exit fees and estimated hedge cost
MIN_EXPECTED_NET_EDGE_USD=1.5

# Extra hedge cost estimate per trade in USD
ESTIMATED_HEDGE_COST_USD=0.0

# Enable a virtual paper hedge to reduce directional exposure in research mode
HEDGE_ENABLED=true

# Hedge size relative to the funding leg. 1.0 = fully hedged notional
HEDGE_RATIO=1.0

# Hedge leg fee and slippage assumptions
HEDGE_FEE_RATE=0.00055
HEDGE_SLIPPAGE_PCT=0.0003

# ── Risk Controls ─────────────────────────────────────────────
# Minimum open interest in USD — filters out illiquid pairs
MIN_OI_USD=500000

# Maximum total loss per day — bot stops new entries when hit
# Resets at 00:00 UTC
MAX_DAILY_LOSS_USD=50

# ── Scanner ───────────────────────────────────────────────────
# How often to poll Bybit for new funding opportunities (seconds)
# 30s is recommended — any slower risks missing the confirmation window
SCAN_INTERVAL_SEC=30

# ── Bybit Fee Rates (linear perpetuals) ──────────────────────
# Taker fee — charged on market orders (entries and post-funding exits)
TAKER_FEE_RATE=0.00055

# Maker fee — unused in the current carry implementation
MAKER_FEE_RATE=0.0002

# ── Logging ──────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
